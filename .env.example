# Copy this file to the repository root as .env, edit locally; NEVER commit .env.
# Presence of keys can be checked safely with: python price_config.py
# Google Shopping provider-reported prices; free plan may have search limits.
SERPAPI_KEY=

# Optional Groq-based explanations, not required for deterministic research.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional legacy OpenAI path; check your provider's available models and billing.
# AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=select_a_current_supported_model

# Optional, explicitly enabled price alerts. Do not commit real destinations or tokens.
PRICE_AGENT_TELEGRAM_BOT_TOKEN=
PRICE_AGENT_TELEGRAM_CHAT_ID=
PRICE_AGENT_SMTP_HOST=
PRICE_AGENT_SMTP_PORT=587
PRICE_AGENT_SMTP_USER=
PRICE_AGENT_SMTP_PASSWORD=
PRICE_AGENT_EMAIL_FROM=
PRICE_AGENT_EMAIL_TO=

# Local preferences are controlled from the app/CLI and stored in SQLite,
# not as API keys. Learning starts DISABLED. No external site scraping is enabled.
